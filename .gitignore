.DS_Store
.env
.claude/settings.local.json
Instagram_Visuals/node_modules/
Instagram_Visuals/pieces/*/exports/.frames-*/
Instagram_Visuals/pieces/*/exports/*.mp4

# root-level scratch clutter (chat-reference screenshots, ad-hoc image copies) --
# these pile up at the repo root every session and were never meant to be committed
/Screenshot *.png
/image.png
/image copy*.png
.vercel
.env*

# stray Rust build cache at the repo root (the real Tower Forge source/build
# lives in world/forge/) -- this is just a local cargo target dir, multi-GB
/forge/target/

# Kokoro narration venv (tools/narration)
tools/narration/.venv/
tools/narration/test-output*.wav

# scratch that piles up beside the pages (chat-reference screenshots, image copies), anywhere in the tree
Screenshot *.png
image copy*.png
__pycache__/
*.pyc
# kit-to-3D working output (tools/kit3d/glb-to-kit.mjs and friends)
/tools/kit3d/out/
