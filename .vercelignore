# Vercel CLI may use this instead of .gitignore (not merged with it), so this
# list is self-sufficient rather than assuming .gitignore's excludes still apply.

# build artifacts / dependencies -- never part of the static site
forge/target
node_modules
Instagram_Visuals/node_modules
.git

# local tooling, not site content
.claude
.env
.DS_Store

# merge debris -- stale, not live code (see .claude/skills/forge/SKILL.md)
forge-world-features
forge-world-features.zip
forge-world-features.patch
forge-integration.patch
forge-loop.patch
forge/web.zip

# chat-reference screenshots and ad-hoc image copies that pile up at the repo
# root every session -- never meant to be published
Screenshot *.png
image.png
image copy*.png

# large one-off exports / decks, not part of any tool
Forge UI Explorations.html
Forge UI Explorations (1).html
*.pptx
